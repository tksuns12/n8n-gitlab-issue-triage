# Copy to .env and fill in. Never commit .env.

# n8n and its database
N8N_ENCRYPTION_KEY=          # openssl rand -hex 24
POSTGRES_PASSWORD=           # openssl rand -hex 16
N8N_PUBLIC_URL=http://localhost:5678/   # public HTTPS URL when GitLab must reach n8n

# GitLab
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=                # project access token, scope: api, role: Reporter or higher
GITLAB_WEBHOOK_SECRET=       # same value as the webhook's "Secret token" in GitLab
TRIAGE_REVIEWER=             # GitLab username to @mention on review requests

# Decision model, any /v1/systemone endpoint. Free default: Mercury Decide on OpenRouter.
# For TypeSafe Jev directly: DECISION_BASE_URL=https://api.typesafe.ai, DECISION_MODEL=jev-latest
DECISION_BASE_URL=https://openrouter.ai/api
DECISION_API_KEY=           # OpenRouter key (OPENROUTER_API_KEY also works)
DECISION_MODEL=inception/mercury-decide:free

# Text LLM for draft comments, any OpenAI-compatible endpoint (Gemini by default)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=                # GEMINI_API_KEY or GOOGLE_API_KEY also work
LLM_MODEL=gemini-2.5-flash
