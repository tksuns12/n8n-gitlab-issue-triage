    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.decision_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $('Settings').first().json.decision_model,\n  state: {\n    title: $('Normalize event').first().json.title,\n    description: $('Normalize event').first().json.description,\n  },\n  questions: {\n    type: {\n      type: 'choice',\n      instructions: 'What kind of work does this GitLab issue ask for? Judge from `title` and `description`.',\n      criteria: {\n        bug: 'Something that works or is documented to work is broken: errors, crashes, wrong results, regressions.',\n        feature: 'A new capability, or a change to existing behaviour that users would notice.',\n        maintenance: 'Upkeep with no user-facing change: refactoring, dependency upgrades, tech debt, tooling, CI.',\n      },\n    },\n    severity: {\n      type: 'score',\n      instructions: 'If this is a defect, how badly does it hurt users?',\n      criteria: [\n        'Cosmetic or a minor inconvenience with an easy workaround',\n        'Some users affected, a workaround exists',\n        'A core feature is broken for many users with no good workaround',\n        'Outage, data loss, or exposure of data',\n      ],\n    },\n    security: {\n      type: 'noul',\n      instructions: 'Does this issue report a security vulnerability, or exposure of secrets or personal data?',\n    },\n    needs_info: {\n      type: 'noul',\n      instructions: 'Is information needed to act on this issue missing, such as steps to reproduce, expected versus actual behaviour, or the version?',\n    },\n  },\n}) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "1fec0d19-5623-5319-b2f2-045a96d105ad",
      "name": "Decision model: classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        260
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "decisionKey00001",
          "name": "Decision model API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// The decision model only proposes. The thresholds in Settings decide what runs without a person.\nconst s = $('Settings').first().json;\nconst ev = $('Normalize event').first().json;\nconst res = $input.first().json;\nconst a = res.answers ?? {};\nconst TYPES = ['bug', 'feature', 'maintenance'];\nconst fmt = (n) => Number(n).toFixed(2);\n\nconst valid = TYPES.includes(a.type?.choice)\n  && typeof a.type?.confidence === 'number'\n  && typeof a.severity?.score === 'number'\n  && typeof a.severity?.confidence === 'number'\n  && typeof a.security?.noul === 'number'\n  && typeof a.needs_info?.noul === 'number';\n\nlet route;\nlet reason;\nlet type = null;\nlet severity = null;\nlet typeProbs = '';\nif (!valid) {\n  route = 'review';\n  reason = res.error\n    ? `결정 모델 호출 실패: ${String(res.error.message ?? res.error).slice(0, 200)}`\n    : '결정 모델 응답 형식이 예상과 다름';\n} else {\n  type = a.type.choice;\n  // Score is a weighted index over levels ordered minor → outage. GitLab's severity::1 is the worst.\n  const level = Math.min(3, Math.max(0, Math.round(a.severity.score)));\n  severity = type === 'bug' ? `severity::${4 - level}` : null;\n  typeProbs = Object.entries(a.type.probabilities ?? {})\n    .sort((x, y) => y[1] - x[1])\n    .map(([k, v]) => `${k} ${fmt(v)}`)\n    .join(' · ');\n\n  const typeSure = a.type.confidence >= s.auto_type_confidence;\n  const severitySure = type !== 'bug' || a.severity.confidence >= s.auto_severity_confidence;\n  if (a.security.noul >= s.security_review_at) {\n    route = 'security';\n    reason = `보안 의심 ${fmt(a.security.noul)}`;\n  } else if (a.needs_info.noul >= s.needs_info_at) {\n    route = 'needs_info';\n    reason = `정보 부족 ${fmt(a.needs_info.noul)}`;\n  } else if (typeSure && severitySure) {\n    route = 'auto';\n    reason = `유형 확신도 ${fmt(a.type.confidence)}`;\n  } else {\n    route = 'review';\n    reason = `확신도 낮음 (유형 ${fmt(a.type.confidence)}, 심각도 ${fmt(a.severity.confidence)})`;\n  }\n}\n\nconst labels = type ? [`type::${type}`, ...(severity ? [severity] : [])] : [];\nconst labelRefs = labels.map((l) => `~\"${l}\"`).join(' ');\nconst autoNote = [\n  `🤖 자동 분류했습니다: ${labelRefs}`,\n  '',\n  `유형 확신도 ${valid ? fmt(a.type.confidence) : '-'} (${typeProbs}). 틀렸다면 라벨을 고쳐 주세요.`,\n].join('\\n');\n\nreturn [{\n  json: {\n    ...ev,\n    triage_id: $('Claim event').first().json.id,\n    route,\n    reason,\n    suggested_type: type ? `type::${type}` : '',\n    suggested_severity: severity ?? '없음',\n    suggested_labels: labels,\n    type_probs: typeProbs,\n    decision_model: res.model ?? null,\n    answers: valid ? a : null,\n    auto_note: autoNote,\n  },\n}];\n"
      },
