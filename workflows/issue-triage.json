    },
    {
      "parameters": {
        "jsCode": "// Builds the internal note that asks a person to review. The link opens the n8n form below.\nconst r = $('Decide route').first().json;\nconst s = $('Settings').first().json;\nconst drafted = $('LLM: draft question').isExecuted\n  ? $('LLM: draft question').first().json.choices?.[0]?.message?.content ?? ''\n  : '';\nconst a = r.answers;\nconst fmt = (n) => Number(n).toFixed(2);\nconst labelRefs = r.suggested_labels.map((l) => `~\"${l}\"`).join(' ') || '(제안 없음)';\nconst mention = s.reviewer ? `@${s.reviewer} ` : '';\n\nconst lines = [\n  `${mention}분류 검토를 부탁드립니다. 사유: ${r.reason}`,\n  '',\n  `- 제안 라벨: ${labelRefs}`,\n];\nif (a) {\n  lines.push(`- 유형 확률: ${r.type_probs} (확신도 ${fmt(a.type.confidence)})`);\n  lines.push(`- 보안 의심 ${fmt(a.security.noul)} · 정보 부족 ${fmt(a.needs_info.noul)}`);\n}\nif (drafted) lines.push('- 작성자에게 보낼 질문 초안이 있습니다. 폼에서 고치거나 지울 수 있습니다.');\nlines.push('', `[검토 폼 열기](${$execution.resumeFormUrl})`);\nlines.push('', `${s.review_hours}시간 안에 응답이 없으면 ~\"triage::needs-human\" 라벨만 붙입니다.`);\n\nreturn [{ json: { draft: drafted.trim(), review_note: lines.join('\\n') } }];\n"
      },
