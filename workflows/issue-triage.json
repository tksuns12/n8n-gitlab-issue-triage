        "jsonBody": "={{ JSON.stringify({\n  model: $('Settings').first().json.llm_model,\n  temperature: 0.2,\n  messages: [\n    {\n      role: 'system',\n      content: 'You help triage GitLab issues. Write a short, polite comment to the reporter asking only for the information that is missing to act on the issue (for example steps to reproduce, expected and actual behaviour, version, logs). Use at most 4 bullet points. Write in the same language as the issue. Do not promise fixes, dates, or causes.',\n    },\n    {\n      role: 'user',\n      content: `Title: ${$('Decide route').first().json.title}\\n\\nDescription:\\n${$('Decide route').first().json.description || '(empty)'}`,\n    },\n  ],\n}) }}",
