      "id": "d284bca2-81ef-53e7-9827-87fae604e03f",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pull out what the rest of the workflow needs and decide whether to triage at all.\nconst hook = $('GitLab Webhook').first().json;\nconst body = hook.body ?? {};\nconst headers = hook.headers ?? {};\nconst issue = body.object_attributes ?? {};\nconst labels = (body.labels ?? []).map((l) => l.title);\n\nlet skip = null;\nif (body.object_kind !== 'issue') skip = 'not an issue event';\nelse if (!['open', 'reopen'].includes(issue.action)) skip = `action is ${issue.action}`;\nelse if (labels.some((l) => l.startsWith('type::'))) skip = 'reporter already set a type label';\n\n// GitLab keeps Idempotency-Key the same when it retries a delivery.\nconst eventKey = headers['idempotency-key']\n  ?? headers['x-gitlab-event-uuid']\n  ?? `${body.project?.id}:${issue.iid}:${issue.action}:${issue.updated_at}`;\n\nreturn [{\n  json: {\n    skip,\n    event_key: eventKey,\n    project_id: body.project?.id ?? null,\n    issue_iid: issue.iid ?? null,\n    issue_url: issue.url ?? '',\n    title: issue.title ?? '',\n    description: (issue.description ?? '').slice(0, 6000),\n  },\n}];\n"
      },
