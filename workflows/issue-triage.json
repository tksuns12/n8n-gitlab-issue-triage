    {
      "parameters": {
        "jsCode": "// The reviewer's answer is final. A timeout or a rejection leaves the issue to a person.\nconst r = $('Decide route').first().json;\nconst f = $input.first().json;\nconst decision = f['결정'];\n\nlet status;\nlet labels;\nlet comment = '';\nif (!decision) {\n  status = 'expired';\n  labels = ['triage::needs-human'];\n} else if (decision.startsWith('거절')) {\n  status = 'rejected';\n  labels = ['triage::needs-human'];\n} else {\n  labels = [f['유형'], f['심각도']].filter((l) => l && l !== '없음');\n  comment = String(f['작성자에게 남길 댓글'] ?? '').trim();\n  const same = [...labels].sort().join() === [...r.suggested_labels].sort().join();\n  status = same ? 'approved' : 'corrected';\n}\nreturn [{ json: { status, labels, comment } }];\n"
      },
      "id": "341dba3e-5d96-59b7-b474-fb27b2d305c5",
      "name": "Read decision",
